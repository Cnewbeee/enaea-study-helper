{
  "manifest_version": 3,
  "name": "ENAEAA 学习助手（弹窗确认 + 自动连播）",
  "version": "2.0.0",
  "description": "自动点击 enaea 学习弹窗，并在视频结束后自动切换到下一集/下一门课程。",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["*://*.enaea.edu.cn/*", "*://enaea.edu.cn/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.enaea.edu.cn/*", "*://enaea.edu.cn/*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["*://*.enaea.edu.cn/*", "*://enaea.edu.cn/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["*://*.enaea.edu.cn/*", "*://enaea.edu.cn/*"],
      "js": ["course-auto.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
